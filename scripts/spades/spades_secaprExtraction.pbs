#!/bin/bash
# Purpose: identify and extract target contigs from SPAdes assemblies using SECAPR.
# Note: this script processes a directory containing all assembled contig files for all samples.
# Note: unlike the ABySS branch, this step is not split by k-mer because SPAdes runs multiple k-mers within one assembly.
# Note: this is an HPC/PBS example and paths should be adapted to the local system.

##### define pbs settings #####
#PBS -N extract_spades_id80
#PBS -l select=1:ncpus=1:mem=200gb:scratch_local=300gb
#PBS -l walltime=23:59:00
#PBS -o extract_spades_id80.txt
#PBS -e extract_spades_id80.txt

##### define variables #####
PROJECT_DIR="/storage/brno3-cerit/home/pedroribeiro/ME_subsample"
CONTIGS_DIR="${PROJECT_DIR}/in_extraction_spades"
REFERENCE_FASTA="${PROJECT_DIR}/reference_target_loci/All_loci_consensus_sequences_v2.fasta"
OUTPUT_DIR="${PROJECT_DIR}/out_extraction_spades/id_80"

BASHRC="/storage/brno3-cerit/home/pedroribeiro/.bashrc"
CONDA_ENV="secapr_env"

TARGET_LENGTH="50"
MIN_IDENTITY="80"

##### system specific definitions #####
trap 'clean_scratch' TERM EXIT
cd "$SCRATCHDIR" || exit 1
export TMPDIR="$SCRATCHDIR"

##### activate environment #####
source "$BASHRC"
mamba activate "$CONDA_ENV"

##### run secapr target-contig extraction #####
secapr find_target_contigs \
  --contigs "$CONTIGS_DIR" \
  --reference "$REFERENCE_FASTA" \
  --output "$OUTPUT_DIR" \
  --target_length "$TARGET_LENGTH" \
  --min_identity "$MIN_IDENTITY"
